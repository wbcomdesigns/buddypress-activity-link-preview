#: bp-activity-link-preview.php bp-activity-link-preview.php:90
#. Plugin Name of the plugin
msgid "Activity Link Preview For BuddyPress"
msgstr "Activity Link Preview für BuddyPress"

#: bp-activity-link-preview.php
#. Plugin URI of the plugin
msgid "https://wbcomdesigns.com/downloads/buddypress-activity-link-preview/"
msgstr "https://wbcomdesigns.com/downloads/buddypress-activity-link-preview/"

#: bp-activity-link-preview.php
#. Description of the plugin
msgid ""
"BuddyPress activity link preview displays as image title and description "
"from the site when links are used in activity posts."
msgstr ""
"BuddyPress activity link preview wird als Bildtitel und Beschreibung der "
"Website angezeigt, wenn Links in activity posts verwendet werden."

#: bp-activity-link-preview.php
#. Author of the plugin
msgid "wbcomdesigns"
msgstr "wbcomdesigns"

#: bp-activity-link-preview.php
#. Author URI of the plugin
msgid "https://wbcomdesigns.com/"
msgstr "https://wbcomdesigns.com/"

#: bp-activity-link-preview.php:89
#. translators: %s: plugin name, wrapped in a <strong> tag.
#, php-format
msgid "%s requires BuddyPress or BuddyBoss Platform to be installed and active."
msgstr ""
"%s benötigt BuddyPress oder BuddyBoss Platform, um installiert und aktiv zu "
"sein."

#: bp-activity-link-preview.php:220
msgid "Cancel Preview"
msgstr "Vorschau abbrechen"

#: bp-activity-link-preview.php:221
msgid "Cancel Preview Image"
msgstr "Vorschaubild abbrechen"

#: bp-activity-link-preview.php:222
msgid "Previous image"
msgstr "Vorheriges Bild"

#: bp-activity-link-preview.php:223
msgid "Next image"
msgstr "Nächstes Bild"

#: bp-activity-link-preview.php:225
#. translators: 1: current image number. 2: total number of images.
#, php-format
msgid "Image %1$s of %2$s"
msgstr "Bild %1$s von %2$s"

#: bp-activity-link-preview.php:248
msgid "You must be logged in to perform this action."
msgstr "Du musst angemeldet sein, um diese Aktion auszuführen."

#: bp-activity-link-preview.php:254
msgid "Security check failed."
msgstr "Sicherheitsprüfung fehlgeschlagen."

#: bp-activity-link-preview.php:263
msgid "The URL you entered is not valid."
msgstr "Die URL, die du eingegeben hast, ist nicht gültig."

#: bp-activity-link-preview.php:272
msgid "This URL cannot be previewed for security reasons."
msgstr ""
"Diese URL kann aus Sicherheitsgründen nicht in der Vorschau angezeigt "
"werden."

#: bp-activity-link-preview.php:279
msgid "Sorry! Preview is not available right now. Please try again later."
msgstr ""
"Entschuldigung! Die Vorschau ist gerade nicht verfügbar. Bitte versuche es "
"später erneut."

#: bp-activity-link-preview.php:689
#. translators: %s: member display name.
#, php-format
msgid "View %s's profile"
msgstr "Profil von %s ansehen"

#: bp-activity-link-preview.php:734
#. translators: %s: group name.
#, php-format
msgid "View the %s group"
msgstr "Gruppe %s ansehen"

