#: bp-activity-link-preview.php bp-activity-link-preview.php:90
#. Plugin Name of the plugin
msgid "Activity Link Preview For BuddyPress"
msgstr "Pré-visualização de Link de Atividade do BuddyPress"

#: bp-activity-link-preview.php
#. Plugin URI of the plugin
msgid "https://wbcomdesigns.com/downloads/buddypress-activity-link-preview/"
msgstr "https://wbcomdesigns.com/downloads/buddypress-activity-link-preview/"

#: bp-activity-link-preview.php
#. Description of the plugin
msgid ""
"BuddyPress activity link preview displays as image title and description "
"from the site when links are used in activity posts."
msgstr ""
"A pré-visualização de link de atividade do BuddyPress exibe a imagem, o "
"título e a descrição do site quando links são usados em posts de atividade."

#: bp-activity-link-preview.php
#. Author of the plugin
msgid "wbcomdesigns"
msgstr "wbcomdesigns"

#: bp-activity-link-preview.php
#. Author URI of the plugin
msgid "https://wbcomdesigns.com/"
msgstr "https://wbcomdesigns.com/"

#: bp-activity-link-preview.php:89
#. translators: %s: plugin name, wrapped in a <strong> tag.
#, php-format
msgid "%s requires BuddyPress or BuddyBoss Platform to be installed and active."
msgstr "%s requer BuddyPress ou BuddyBoss Platform instalado e ativo."

